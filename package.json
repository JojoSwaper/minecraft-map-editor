{
  "name": "minecraft-web-voxel-editor",
  "version": "1.0.0",
  "description": "This is a lightweight, browser-based voxel editor inspired by Minecraft. It can import selections from your world and let you build on top of them directly in the browser.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild app.js --bundle --format=esm --platform=browser --outfile=dist/bundle.js",
    "start": "npm run build && electron ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JojoSwaper/minecraft-map-editor.git"
  },
