  },
  "homepage": "https://github.com/JojoSwaper/minecraft-map-editor#readme",
  "dependencies": {
    "buffer": "^6.0.3",
    "electron": "^40.1.0",
    "pako": "^2.1.0",
    "prismarine-nbt": "^2.8.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
